# ===========================================================================
# Production / single-VPS configuration for docker-compose.yml.
# Copy to .env and replace every CHANGE_ME. This one file feeds the API,
# queue, scheduler and Reverb containers; MySQL and Redis read their
# credentials from it as well.
# ===========================================================================

# --- Domain & TLS -----------------------------------------------------------
# Serves {APP_DOMAIN}, api.{APP_DOMAIN} and ws.{APP_DOMAIN}. Point all three
# DNS records at the VPS. Use "localhost" to try the stack locally.
APP_DOMAIN=gym.example.et
ACME_EMAIL=admin@example.et

# Optional: pre-fill this gym ID on the staff login page (single-gym installs).
DEFAULT_ORGANIZATION=

# --- Laravel ----------------------------------------------------------------
APP_NAME="Gym Platform"
APP_ENV=production
# Generate with: docker compose run --rm api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.gym.example.et
FRONTEND_URL=https://gym.example.et
CORS_ALLOWED_ORIGINS=https://gym.example.et

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (MySQL 8 container) -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gym
DB_USERNAME=gym
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- Redis: queues, cache and sessions --------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Leading dot shares the session cookie between gym.example.et and api.gym.example.et.
SESSION_DOMAIN=.gym.example.et
# Must match SESSION_COOKIE_NAME in the web app (used for its login redirect).
SESSION_COOKIE=gym_session
SANCTUM_STATEFUL_DOMAINS=gym.example.et

FILESYSTEM_DISK=local

# --- Reverb (real-time check-in desk) ---------------------------------------
# The API talks to Reverb inside the Docker network; browsers connect through
# Caddy at wss://ws.{APP_DOMAIN}.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=gym
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.et
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.et"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gym platform defaults (config/gym.php) ---------------------------------
# Organizations and branches can override these from the admin UI later.
GYM_TIMEZONE=Africa/Addis_Ababa
GYM_CURRENCY=ETB
GYM_TAX_ENABLED=false
GYM_TAX_NAME=VAT
GYM_TAX_RATE=15.00
GYM_TAX_PRICES_INCLUSIVE=true
GYM_FEATURE_FREEZE=false
GYM_FEATURE_LOCKERS=false
GYM_FEATURE_CHAPA=false

# --- Chapa (optional online payments) ---------------------------------------
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=

# --- Notifications: members pick Telegram / WhatsApp / SMS / email ----------
NOTIFY_DEFAULT_CHANNEL=sms

# Telegram bot from @BotFather. The username is also baked into the web build.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). Messages outside a 24h reply window
# must use pre-approved templates.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

SMS_ENABLED=false
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=

EMAIL_NOTIFICATIONS_ENABLED=true
