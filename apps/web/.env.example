# Public URL of the Laravel API (no trailing slash, without /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reverb WebSocket endpoint for the live check-in desk.
NEXT_PUBLIC_REVERB_APP_KEY=local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Telegram bot members open to link notifications (username without @).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Pre-fills the gym ID on the staff login page (single-gym deployments).
NEXT_PUBLIC_ORGANIZATION=

# Name of the Laravel session cookie (API SESSION_COOKIE). Read at runtime by
# the proxy to redirect signed-out visitors away from staff pages.
SESSION_COOKIE_NAME=gym_session

# Public site address, used for absolute links in share previews (Telegram, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
