# Public URL of the Laravel API (no trailing slash, without /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reverb WebSocket endpoint for the live check-in desk.
NEXT_PUBLIC_REVERB_APP_KEY=local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Telegram bot members open to link notifications (username without @).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
